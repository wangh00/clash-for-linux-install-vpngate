######################################
#
#   全局参数模板
#   首次安装时会复制为被 Git 忽略的 .env
#
######################################

CLASHCTL_SUB_CONNECT_TIMEOUT=5
CLASHCTL_SUB_TIMEOUT=20
CLASHCTL_SUB_RETRY=2
CLASHCTL_SUB_UA=clash-verge/v2.4.0

CLASHCTL_NODE_DELAY_URL=http://www.gstatic.com/generate_204
CLASHCTL_NODE_DELAY_TIMEOUT=5000
CLASHCTL_NODE_DELAY_CONCURRENCY=8

CLASHCTL_VPNGATE_API_URL=https://www.vpngate.net/api/iphone/
CLASHCTL_VPNGATE_CONNECT_TIMEOUT=10
CLASHCTL_VPNGATE_FETCH_TIMEOUT=90
CLASHCTL_VPNGATE_RETRY=2
CLASHCTL_VPNGATE_LIMIT=0
CLASHCTL_VPNGATE_AUTO_PROBE_LIMIT=20
CLASHCTL_VPNGATE_DELAY_URL=https://cp.cloudflare.com
CLASHCTL_VPNGATE_TEST_TIMEOUT=20000
CLASHCTL_VPNGATE_UPDATE_INTERVAL=60
CLASHCTL_VPNGATE_UPDATE_BOOT_DELAY=5
CLASHCTL_VPNGATE_HOT_RELOAD=1

# 以下值会在安装时按实际环境写入安装目录的 .env
CLASHCTL_KERNEL=mihomo
INIT_TYPE=
CLASHCTL_PROXY_USERNAME=vpngate
CLASHCTL_PROXY_PASSWORD=
CLASHCTL_MIXED_PORT=7890
CLASHCTL_LAN_BIND_ADDRESS=0.0.0.0
